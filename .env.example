# Browser-safe public values. Supabase RLS must remain enabled.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Naver Maps JavaScript API (Dynamic Map)
NEXT_PUBLIC_NAVER_MAP_CLIENT_ID=

# Server-side/manual geocoding only. Never expose the secret in client code.
NAVER_MAPS_GEOCODING_CLIENT_ID=
NAVER_MAPS_GEOCODING_CLIENT_SECRET=

# Optional local administration scripts only. Never expose to the browser.
SUPABASE_SECRET_KEY=
