# Public project values. These are safe to expose to the browser when RLS is enabled.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Naver Maps JavaScript API (Dynamic Map)
NAVER_MAP_CLIENT_ID=

# Server-side/manual geocoding only. Never expose the secret in client code.
NAVER_MAPS_GEOCODING_CLIENT_ID=
NAVER_MAPS_GEOCODING_CLIENT_SECRET=

# Optional: use only for one-time, trusted import tooling. Never add to Sites runtime.
SUPABASE_SERVICE_ROLE_KEY=
